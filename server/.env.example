# ============================================================
# SmartLearning Server — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.

# ─── Server ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT ────────────────────────────────────────────────────
# Secret key for signing JWT tokens (generate a strong random string)
# Example: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
JWT_EXPIRES_IN=24h

# ─── PostgreSQL Database ────────────────────────────────────
# Connection string for the PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartlearning
DB_USER=postgres
DB_PASSWORD=your_db_password

# ─── File Storage ───────────────────────────────────────────
# Absolute path to the folder where uploaded files will be stored
# This folder must exist and be writable by the Node.js process
STORAGE_PATH=/var/data/smartlearning/uploads

# Base URL for generating file download links (your server's public URL)
SERVER_PUBLIC_URL=http://localhost:3001

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Migration UI ───────────────────────────────────────────
# Token required to access /migrate page and run DB imports.
# Generate with: openssl rand -hex 32
MIGRATE_TOKEN=CHANGE_ME_TO_A_RANDOM_STRING
